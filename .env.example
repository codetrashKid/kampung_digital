# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# Connection string PostgreSQL dari penyedia database (Neon/Supabase/dll).
# Gunakan versi "pooled" bila tersedia (cocok untuk Vercel; Supabase: Transaction pooler, port 6543).
# Bila sandi memuat karakter khusus, tulis dalam bentuk URL-encoded (mis. % menjadi %25, @ menjadi %40).
DATABASE_URL=

# Slug lingkungan yang ditampilkan portal ini (harus ada di tabel communities).
DEFAULT_COMMUNITY_SLUG=contoh-kampung

# Kunci rahasia untuk menandatangani sesi login admin (minimal 32 karakter acak).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Di Vercel, isi juga di Environment Variables.
AUTH_SECRET=
