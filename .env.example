# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# Connection string PostgreSQL dari penyedia database (Neon/Supabase/dll).
# Gunakan versi "pooled" bila tersedia (cocok untuk Vercel).
DATABASE_URL=

# Slug lingkungan yang ditampilkan portal ini (harus ada di tabel communities).
DEFAULT_COMMUNITY_SLUG=contoh-kampung
